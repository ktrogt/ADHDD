{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Perfboard placement v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "parts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "footprint": {
            "type": "string",
            "minLength": 1
          },
          "hole": {
            "type": "string",
            "pattern": "^[A-Z]+[1-9][0-9]*$"
          },
          "rotation": {
            "enum": [
              0,
              90,
              180,
              270
            ],
            "default": 0
          },
          "locked": {
            "type": "boolean",
            "default": false
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          },
          "pin_map": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "number": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "number",
                "name"
              ]
            }
          },
          "substitution_approved": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "footprint",
          "hole"
        ]
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[A-Z]+[1-9][0-9]*$"
          },
          {
            "type": "object",
            "properties": {
              "hole": {
                "type": "string",
                "pattern": "^[A-Z]+[1-9][0-9]*$"
              }
            },
            "required": [
              "hole"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "parts"
  ]
}
